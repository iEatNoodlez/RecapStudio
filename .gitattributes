# text files are stored with LF; Windows scripts keep CRLF wherever they're checked out or downloaded
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
# Linux scripts keep LF everywhere, or bash can't run them
*.sh text eol=lf
packaging/linux/AppRun text eol=lf
*.ico binary
*.png binary
