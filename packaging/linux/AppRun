#!/bin/bash
# Recap Studio's AppImage: starts the app with the Python inside it, passing on any options (--browser,
# --no-window). The AppImage's runtime mounts it and sets APPDIR (where) and APPIMAGE (its file), which the app
# uses to update and restart itself (recap/system.py).
#   Recap-Studio-*.AppImage --mcp    Recap Studio's MCP server for Claude Code (recap/mcp_stdio.py)
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
export APPDIR

# this Python only: nothing from another Python on the computer
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP VIRTUAL_ENV
export PYTHONNOUSERSITE=1
# the window is Qt's (pywebview would look for GTK first)
export PYWEBVIEW_GUI=qt

PY="$APPDIR/python/bin/python3"
cd "$APPDIR" || exit 1  # (-m recap finds the app here)
case "${1:-}" in
  --mcp) shift; exec "$PY" "$APPDIR/recap/mcp_stdio.py" "$@" ;;
  --version) cat "$APPDIR/VERSION"; exit 0 ;;
esac
exec "$PY" -m recap "$@"
